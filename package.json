{
  "name": "message-moment",
  "version": "0.2.0",
  "private": true,
  "description": "Personal WhatsApp scheduling with desktop sending and mobile companions",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "server": "node server/main.cjs",
    "test": "node --test test/*.test.cjs",
    "predesktop:build": "node scripts/prepare-browser.cjs",
    "desktop:build": "electron-builder --win nsis",
    "android:add": "cap add android",
    "ios:add": "cap add ios",
    "mobile:sync": "cap sync",
    "android:open": "cap open android",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "mongodb": "^6.21.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "mongodb-memory-server": "^11.3.0"
  },
  "build": {
    "appId": "com.messagemoment.desktop",
    "productName": "Message Moment",
    "asar": true,
    "files": [
      "desktop/**",
      "server/**",
      "www/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/browser",
        "to": "browser"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
